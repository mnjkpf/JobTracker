# =====================================================
# Місце: <repo-root>/.editorconfig
# =====================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{java,kt,xml}]
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{sql}]
indent_size = 4

[Makefile]
indent_style = tab